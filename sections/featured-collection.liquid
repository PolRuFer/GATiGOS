{{ 'product-media.css' | asset_url | stylesheet_tag }}
{{ 'section-selection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  if section.settings.eyebrow != blank
    assign eyebrow = section.settings.eyebrow
  else
    assign eyebrow = 'selection.eyebrow' | t
  endif
  if section.settings.heading != blank
    assign heading = section.settings.heading
  else
    assign heading = 'selection.heading' | t
  endif
  assign uid = 'Selection-' | append: section.id
  assign sizes = '(min-width: 990px) calc((100vw - 12vw - 6rem) / 4), (min-width: 750px) calc((100vw - 12vw - 1.5rem) / 2), calc((100vw - 3.5rem) / 2)'
-%}

<section class="selection has-orbs full-width" aria-labelledby="{{ uid }}-title">
  <div class="orbs orbs--fade-end" aria-hidden="true">
    <span class="orb orb--camel" style="--orb-x: 88%; --orb-y: 10%; --orb-size: 48vw; --orb-opacity: 0.24;"></span>
  </div>

  <div class="selection__inner page-width">
    <header class="selection__head">
      <div>
        <p class="selection__eyebrow eyebrow">{{ eyebrow | escape }}</p>
        <h2 class="display display--title" id="{{ uid }}-title">{{ heading | escape }}</h2>
      </div>
      {%- if collection -%}
        <a class="link-underline" href="{{ collection.url }}">{{ 'selection.view_all' | t }}</a>
      {%- endif -%}
    </header>

    {%- if collection.products.size > 0 -%}
      <ul class="selection__grid grid" role="list">
        {%- for product in collection.products limit: 8 -%}
          <li class="selection__item">
            {% render 'product-card', product: product, scope: uid, sizes: sizes %}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p>{{ 'selection.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.selection.name",
  "class": "section-selection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.room.settings.eyebrow.label",
      "info": "t:sections.shared.locale_fallback"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.room.settings.heading.label",
      "info": "t:sections.shared.locale_fallback"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.room.settings.collection.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.selection.name"
    }
  ]
}
{% endschema %}
