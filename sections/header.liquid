{{ 'section-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign menu = section.settings.menu
  assign cart_label = 'header.cart_label' | t: count: cart.item_count
-%}

<site-header class="site-header" data-site-header>
  <header class="site-header__bar">
    <div class="site-header__glass site-header__glass--light glass glass--dense glass--pill" aria-hidden="true"></div>
    <div class="site-header__glass site-header__glass--dark glass glass--dark glass--dense glass--pill" aria-hidden="true"></div>

    <a class="site-header__logo" href="{{ routes.root_url }}">
      {{- shop.name | escape -}}
    </a>

    {%- if menu.links.size > 0 -%}
      <nav class="site-header__nav" aria-label="{{ 'header.nav_label' | t }}">
        <ul class="site-header__menu" role="list">
          {%- for link in menu.links -%}
            {%- if link.links.size > 0 -%}
              <li class="site-header__item" data-dropdown>
                <button
                  class="site-header__link site-header__trigger"
                  type="button"
                  aria-expanded="false"
                  aria-controls="HeaderDropdown-{{ forloop.index }}"
                  {% if link.child_active or link.active %}
                    data-active
                  {% endif %}
                >
                  {{- link.title | escape -}}
                  <span class="site-header__caret" aria-hidden="true"></span>
                </button>
                <div id="HeaderDropdown-{{ forloop.index }}" class="site-header__dropdown glass glass--dense">
                  <ul class="site-header__sublist" role="list">
                    {%- for child in link.links -%}
                      <li>
                        <a
                          class="site-header__sublink"
                          href="{{ child.url }}"
                          {% if child.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {% render 'menu-figure', link: child %}
                          <span>{{ child.title | escape }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </li>
            {%- else -%}
              <li class="site-header__item">
                <a
                  class="site-header__link"
                  href="{{ link.url }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="site-header__tools">
      {% render 'localization-form', form_id: 'HeaderLocalization', class: 'site-header__lang' %}

      <a class="site-header__cart" href="{{ routes.cart_url }}" aria-label="{{ cart_label }}">
        {{- 'header.cart' | t -}}
        {%- if cart.item_count > 0 -%}
          <span class="site-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>

      <button
        class="site-header__menu-toggle"
        type="button"
        aria-haspopup="dialog"
        aria-controls="MobileMenu"
        aria-expanded="false"
        data-menu-open
      >
        {{- 'header.menu_open' | t -}}
      </button>
    </div>
  </header>

  <dialog
    id="MobileMenu"
    class="mobile-menu glass glass--dense"
    aria-label="{{ 'header.menu_label' | t }}"
    data-mobile-menu
    scroll-lock
  >
    <div class="mobile-menu__top">
      <span class="site-header__logo" aria-hidden="true">{{ shop.name | escape }}</span>
      <button class="mobile-menu__close" type="button" data-menu-close>
        {{- 'header.menu_close' | t -}}
      </button>
    </div>

    {%- if menu.links.size > 0 -%}
      <nav class="mobile-menu__nav" aria-label="{{ 'header.nav_label' | t }}">
        <ul class="mobile-menu__list" role="list">
          {%- for link in menu.links -%}
            <li>
              {%- if link.links.size > 0 -%}
                <p class="mobile-menu__group eyebrow" id="MobileMenuGroup-{{ forloop.index }}">{{ link.title | escape }}</p>
                <ul class="mobile-menu__sublist" role="list" aria-labelledby="MobileMenuGroup-{{ forloop.index }}">
                  {%- for child in link.links -%}
                    <li>
                      <a
                        class="mobile-menu__link mobile-menu__sublink"
                        href="{{ child.url }}"
                        {% if child.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {% render 'menu-figure', link: child %}
                        <span>{{ child.title | escape }}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <a
                  class="mobile-menu__link"
                  href="{{ link.url }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="mobile-menu__bottom">
      {% render 'localization-form', form_id: 'MobileMenuLocalization', class: 'mobile-menu__lang' %}
      <a class="mobile-menu__cart" href="{{ routes.cart_url }}" aria-label="{{ cart_label }}">
        {{- 'header.cart' | t -}}
        {%- if cart.item_count > 0 -%}
          <span class="site-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </dialog>
</site-header>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "info": "t:sections.header.settings.menu.info",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
