<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#EDE6DA">
    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    {%- unless request.design_mode -%}
      {% # Motion layout is decided before first paint (no layout shift). %}
      <script>
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('motion-ok');
        }
      </script>
    {%- endunless -%}

    {% # Self-hosted fonts: preload + @font-face with font-display: swap %}
    {% render 'css-variables' %}

    {% # Tokens, reset, type and grid; then the glass material %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'glass.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # ES modules resolve through this map; heavy ones are imported on demand %}
    <script type="importmap">
      {
        "imports": {
          "three": "{{ 'three.min.js' | asset_url }}",
          "vendor-motion": "{{ 'vendor-motion.min.js' | asset_url }}",
          "@gatygos/ticker": "{{ 'ticker.js' | asset_url }}",
          "@gatygos/hero-scene": "{{ 'hero-scene.js' | asset_url }}",
          "@gatygos/motion-hero": "{{ 'motion-hero.js' | asset_url }}",
          "@gatygos/motion-rooms": "{{ 'motion-rooms.js' | asset_url }}",
          "@gatygos/motion-cards": "{{ 'motion-cards.js' | asset_url }}",
          "@gatygos/motion-manifesto": "{{ 'motion-manifesto.js' | asset_url }}"
        }
      }
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'motion.js' | asset_url }}" type="module"></script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
