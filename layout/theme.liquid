<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#EDE6DA">
    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    {% # Self-hosted fonts: preload + @font-face with font-display: swap %}
    {% render 'css-variables' %}

    {% # Tokens, reset, type and grid; then the glass material %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'glass.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
